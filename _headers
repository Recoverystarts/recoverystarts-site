# Response headers for Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# The self-hosted fonts never change under a name (a new font gets a new file name), so phones keep them for a year
# instead of asking again on every page.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Preview copies on *.pages.dev may run inline scripts and our own files only, so Raptive's loader and GA don't start
# there (Raptive is approved for recoverystarts.com only). recoverystarts.com and www get no header from this.
https://:project.pages.dev/*
  Content-Security-Policy: script-src 'self' 'unsafe-inline'
https://:version.:project.pages.dev/*
  Content-Security-Policy: script-src 'self' 'unsafe-inline'

# Content-Language matching each page's <html lang>: English by default, and each /<lang>/ folder its own tag.
# Pages joins the values of every rule that matches a path, so each language rule first drops the English one
# ("! Content-Language").
/*
  Content-Language: en
/es/*
  ! Content-Language
  Content-Language: es
/pt/*
  ! Content-Language
  Content-Language: pt-BR
/fr/*
  ! Content-Language
  Content-Language: fr
/de/*
  ! Content-Language
  Content-Language: de
/fa/*
  ! Content-Language
  Content-Language: fa
/pl/*
  ! Content-Language
  Content-Language: pl
/sv/*
  ! Content-Language
  Content-Language: sv
/nl/*
  ! Content-Language
  Content-Language: nl
/hi/*
  ! Content-Language
  Content-Language: hi
/ja/*
  ! Content-Language
  Content-Language: ja
/ru/*
  ! Content-Language
  Content-Language: ru
/ar/*
  ! Content-Language
  Content-Language: ar
/tr/*
  ! Content-Language
  Content-Language: tr

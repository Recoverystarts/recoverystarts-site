 },
 "f028efa041cb": {
  "t": "The Twelve Steps are A.A.'s program of recovery, first printed in the book <0>Alcoholics Anonymous</0> (the Big Book) in April 1939, in the chapter \"How It Works\" on pages 59–60. Our page sets out each Step and where the Big Book explains how to take it.",
  "kind": "html",
  "pages": [
   "start-here/index.html"
  ]
 },
 "2102946cf065": {
  "t": "<0>The 12 Steps in the Big Book — Page-by-Page</0>",
  "kind": "html",
  "pages": [
   "start-here/index.html"
  ]
 },
 "220e15c40963": {
  "t": "The Traditions are the principles A.A. groups adopted in 1950 to keep the fellowship together and unowned. The Big Book prints the long form in Appendix I (pp. 563–566), and our page sets out what each one actually says. The history page follows how they were worked out from 1937 to 1950, from the letters and the sources.",
  "kind": "html",
  "pages": [
   "start-here/index.html"
  ]
 },
 "21074a0e8fad": {
  "t": "<0>The 12 Traditions of A.A. — What They Actually Say (Long Form, pp. 563–566)</0>",

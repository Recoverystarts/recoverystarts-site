 "6be3f89278a0": {
  "t": "Everything on Recovery Starts that's meant to be read, on one page. That's the Twelve Steps, Traditions and Concepts, the story of how A.A. began, the Big Book page by page, answers to the questions people ask about A.A., and a reading for every day of the year.",
  "kind": "html",
  "pages": [
   "start-here/index.html"
  ]
 },
 "b964d3f640fa": {
  "t": "Each page is written from A.A.'s own literature and names the page you can check it against. Every page is free, with no account and no sign-up. Recovery Starts is an independent project, not affiliated with Alcoholics Anonymous World Services. If you're looking for a meeting tonight, the <0>meetings map</0> and <1>online meetings</1> are the place to start.",
  "kind": "html",
  "pages": [
